# Copy to .env and keep it on the server only. Never add real credentials to GitHub Pages.
PORT=8787
NODE_ENV=development
DB_PATH=./backend/data/naija-life.sqlite
PUBLIC_API_URL=https://your-api-host.example
# Public Pages origin (the exact origin, without a path); required for CORS and cross-site cookie sessions.
FRONTEND_ORIGIN=https://2gud4u-bit.github.io
# Full public game URL, including /naija-life; used only to build password-reset links.
FRONTEND_URL=https://2gud4u-bit.github.io/naija-life
# Password reset mail through Resend. Keep the API key server-only and verify the sender domain with Resend.
RESEND_API_KEY=
RESET_EMAIL_FROM=Naija Life <accounts@your-verified-domain.example>
PAYMENT_SANDBOX=true
LIVE_PAYMENTS_ENABLED=false

# Server-priced packs: amountMinor is NGN kobo; creditUnits is game currency.
# Leave empty until you choose the actual price-to-credit packages.
PAYMENT_PACKAGES_JSON={}

PAYSTACK_SECRET_KEY=
OXAPAY_MERCHANT_API_KEY=
CRYPTO_CURRENCIES=BTC,ETH,USDT,USDC,TRX
# Optional currency:network allowlist for OxaPay. Keep networks explicit.
CRYPTO_NETWORKS=USDT:TRC20,USDT:Polygon,USDT:ERC20,USDC:Polygon,USDC:ERC20
